# frontend/.dockerignore —— 仅对 frontend build context 生效
# 注意：.env.production 不能忽略！Vite 在 `npm run build` 阶段会读取它
# 并把变量编译进 dist/ 产物（import.meta.env），构建完成后产物已包含生产值。

# 依赖与构建产物（多阶段构建第一阶段会重新 npm install + npm run build，无需带入）
node_modules
dist
dist-ssr
*.local

# 开发环境变量（可能含本地密钥，不能进镜像；.env.production 保留）
.env
.env.local
.env.development
.env.development.local

# 版本控制
.git
.gitignore
.gitattributes

# 测试与缓存
__tests__
*.test.js
*.test.jsx
*.spec.js
*.spec.jsx
coverage
.nyc_output

# IDE 与编辑器
.vscode
.idea
*.swp
*.swo
*~

# 日志与临时文件
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
.DS_Store

# 文档（构建不需要）
README.md
