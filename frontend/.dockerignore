# frontend/.dockerignore applies only to the frontend Docker build context.
# Vite can inline VITE_* values at build time, so real env files must never
# enter the Docker context for public-demo smoke builds.

# Dependencies and build outputs are recreated inside the image.
node_modules
dist
dist-ssr

# Real environment files: keep out of Docker context.
.env
.env.*
.env.production
.env.local
.env.*.local
!.env.example

# Version control metadata.
.git
.gitignore
.gitattributes

# Tests and coverage are not required for the production static build.
__tests__
*.test.js
*.test.jsx
*.spec.js
*.spec.jsx
coverage
.nyc_output

# Editor, log, and local machine files.
.vscode
.idea
*.swp
*.swo
*~
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
.DS_Store

# Documentation is not needed in the image build context.
README.md
