# Frontend 环境变量示例
# 复制为 .env.local 后按需修改；切勿将真实密钥提交到仓库。

VITE_API_BASE_URL=/api
# Public-demo: set this in Vercel to direct-connect WebSocket to Render.
# Do not include credentials, tokens, or query strings in this URL.
# Example: wss://agentx-backend-s4r5.onrender.com/ws
VITE_WS_BASE=

# ===== Public registration =====
# 默认关闭。只有在公网注册验证窗口内，且后端 PUBLIC_REGISTRATION_ENABLED=true 时才设为 true。
VITE_PUBLIC_REGISTRATION_ENABLED=false

# ===== Demo / 访客账号 =====
# 仅用于本地开发与演示，生产环境务必保持禁用（不设置或设为 false）。
# 启用后登录页会显示「以访客身份继续」按钮，使用下方账号自动登录。
VITE_DEMO_ENABLED=false
VITE_DEMO_USERNAME=demo
VITE_DEMO_PASSWORD=change-me-dev-only
