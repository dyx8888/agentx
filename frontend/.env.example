# AgentX frontend environment template
# Copy to .env.local for local development, or configure equivalent variables in the hosting platform.
# Do not commit filled local environment files.

# API base URL used by axios client.
# Same-origin reverse proxy deployment can keep this as /api.
# Split frontend/backend deployment should use the backend HTTPS URL, for example:
# VITE_API_BASE_URL=https://api.example.com/api
VITE_API_BASE_URL=/api

# Optional WebSocket base URL.
# Leave blank for the default same-origin /ws behavior.
# VITE_WS_BASE=wss://api.example.com/ws
VITE_WS_BASE=

# Demo login must stay disabled in production unless the backend has a controlled public demo account.
VITE_DEMO_ENABLED=false
VITE_DEMO_USERNAME=demo
VITE_DEMO_PASSWORD=
