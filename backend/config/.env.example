# AgentX Platform Environment Configuration

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/agentx

# Vector Database Configuration
# 可选值: chromadb (默认) 或 milvus
VECTOR_DB=chromadb

# Milvus Connection Configuration (when VECTOR_DB=milvus)
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=brand_scripts

# Model Configuration
MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Logging Configuration
LOG_LEVEL=INFO

# JWT Configuration
JWT_SECRET=your-secret-key-here

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379/0

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIR=./uploads

