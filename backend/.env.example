# AgentX Environment Configuration Example

# Database Configuration
# Uncomment to use PostgreSQL instead of SQLite
# DATABASE_URL=postgresql://user:password@localhost:5432/agentx

# Tool Loading Mode
# Set to 'http' to enable HTTP tool services (Docker environment)
##TOOL_LOAD_MODE=http

# HTTP Tool Service Mode
# Set to 'true' to run tool servers as independent services
# RUN_AS_HTTP_SERVICE=true

# Model Configuration
# OPENAI_API_KEY=your_openai_api_key
DEEPSEEK_API_KEY=your_key_here

# Hugging Face Configuration
# Use mirror for faster model downloads in China
HF_ENDPOINT=https://hf-mirror.com

# Docker Environment Variables
# These are automatically set by docker-compose
# COMPOSE_PROJECT_NAME=agentx
# COMPOSE_FILE=docker-compose.yml

# Logging Configuration
# ENV: dev (colored console) | prod (JSON for ELK/Splunk)
ENV=dev
# SERVICE_NAME: Service identifier in logs (default: agentx-backend)
# SERVICE_NAME=agentx-backend
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# RotatingFileHandler configuration
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Server Configuration
# HOST=0.0.0.0
# PORT=8000

# Service URLs (for Docker networking)
# KOL_SEARCH_URL=http://kol-search:8101
# REPORT_SERVER_URL=http://report-server:8104
