# AgentX Environment Configuration Example

# Database Configuration
# Uncomment to use PostgreSQL instead of SQLite
# DATABASE_URL=postgresql://user:password@localhost:5432/agentx

# Tool Loading Mode
# Set to 'http' to enable HTTP tool services (Docker environment)
##TOOL_LOAD_MODE=http

# HTTP Tool Service Mode
# Set to 'true' to run tool servers as independent services
# RUN_AS_HTTP_SERVICE=true

# Model Configuration
# OPENAI_API_KEY=your_openai_api_key
# 变更③ T3.5：第三方 API Key 必须使用占位符，禁止填入真实密钥
# DEEPSEEK_API_KEY=<your-deepseek-api-key>
# TOKENRHYTHM_API_KEY=your_tokenrhythm_api_key
# AGENT_EVAL_BASE_URL=https://your-relay.example.com/v1
# AGENT_EVAL_API_KEY=your_relay_api_key
# AGENT_EVAL_MODEL_NAME=default
# MODEL_GATEWAY_DEFAULT=deepseek
# AGENT_EVAL_MODEL=deepseek
# EVALUATION_MODEL=deepseek

# Hugging Face Configuration
# Use mirror for faster model downloads in China
HF_ENDPOINT=https://hf-mirror.com

# Docker Environment Variables
# These are automatically set by docker-compose
# COMPOSE_PROJECT_NAME=agentx
# COMPOSE_FILE=docker-compose.yml

# Logging Configuration
# ENV: dev (colored console) | prod (JSON for ELK/Splunk)
ENV=dev
# SERVICE_NAME: Service identifier in logs (default: agentx-backend)
# SERVICE_NAME=agentx-backend
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# RotatingFileHandler configuration
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Server Configuration
# HOST=0.0.0.0
# PORT=8000
# 变更③ T3.4：CORS 白名单
# 开发环境允许 "*"（允许携带 Cookie 时浏览器会忽略 credentials，故通配源自动关闭 credentials）
# 生产环境必须配置逗号分隔的具体域名列表，配置 "*" 会导致启动失败（RuntimeError）
# 示例：CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=*

# 变更③ T3.5：安全密钥配置
# 生产环境（ENV=prod）启动时若密钥缺失或为默认值，会直接 RuntimeError 阻止启动
# 生成 JWT_SECRET_KEY:  python -c "import secrets; print(secrets.token_hex(32))"
# 生成 ENCRYPTION_KEY:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 禁止使用 changeme / default / your_jwt_secret 等默认值
# 本地 HTTP 联调请保持 false；HTTPS 部署请设为 true
COOKIE_SECURE=false
# Production mock safety gates. Keep these false outside local demos/tests.
ALLOW_PLATFORM_MOCK_FALLBACK=false
ALLOW_ENTERPRISE_MOCK_INTEGRATIONS=false
# JWT_SECRET_KEY=在此填入生成的 64 位十六进制密钥
# ENCRYPTION_KEY=在此填入生成的 Fernet 密钥

# ── 嵌入服务配置 ──
# EMBEDDING_MODE: 嵌入后端模式 local / api_siliconflow / api_deepseek / api_openai
#EMBEDDING_MODE=local
# EMBEDDING_API_KEY: 嵌入 API 全局兜底密钥（留空则各公司自行配置）
#EMBEDDING_API_KEY=
# EMBEDDING_MODEL: 本地模式加载的模型名（默认 BAAI/bge-small-zh-v1.5）
#EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ── 向量数据库配置 ──
# VECTOR_DB: 向量后端类型，生产默认 milvus（与 app/rag 业务代码一致）
# 业务代码（hybrid_retriever / multimodal_retriever / runtime/memory / main）均使用 pymilvus 连接 Milvus
# 可选切换为 chromadb（需 pip install chromadb，仅作为备选后端，生产不推荐）
VECTOR_DB=milvus
# Milvus 向量数据库（生产默认）
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=agentx_vectors
# 可选：切换为 chromadb（需 pip install chromadb）
# VECTOR_DB=chromadb

# GraphRAG 动态实体抽取模式：
# async = 默认，知识上传先返回，后台抽取图谱实体；sync = 等抽取完成后再返回；off = 关闭动态抽取
GRAPH_RAG_DYNAMIC_EXTRACTION_MODE=async

# ── JWT 过期时间配置 ──
# JWT_EXPIRE_MINUTES: access token 有效期（分钟），默认 30
#JWT_EXPIRE_MINUTES=30
# JWT_REFRESH_EXPIRE_DAYS: refresh token 有效期（天），默认 7
#JWT_REFRESH_EXPIRE_DAYS=7

# ── 邮件通知 SMTP 配置（evolution notifier）──
# 未配置 SMTP_HOST 时邮件通知功能自动跳过，不会阻塞主流程
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=

# ── Redis 配置（可选）──
# dev/mvp 模式可不配置，后端连接失败时自动降级到内存队列
# 生产部署强烈建议配置，以下功能依赖 Redis：
#   - 限流器分布式计数（多实例共享）
#   - 用户对象缓存（get_current_user 跳过 DB 查询）
#   - checkpoint/session_store（LangGraph 状态持久化）
#   - token 黑名单（logout 后 refresh token 失效）
#REDIS_URL=redis://localhost:6379/0

# ── 限流配置（P0 优化：环境变量可配）──
# 所有阈值默认值适合开发环境，生产环境请根据实际负载调整
# RATE_LIMIT_WINDOW: 限流窗口（秒），默认 60
#RATE_LIMIT_WINDOW=60
# RATE_LIMIT_USER: 每用户每窗口最大请求数，默认 120
#RATE_LIMIT_USER=120
# RATE_LIMIT_IP: 每 IP 每窗口最大请求数，默认 200
#RATE_LIMIT_IP=200
# RATE_LIMIT_LLM: 每公司每窗口最大 LLM 调用数，默认 10
#RATE_LIMIT_LLM=10
# RATE_LIMIT_LOGIN: 每 IP 每 5 分钟最大登录尝试数，默认 20
#RATE_LIMIT_LOGIN=20
# 多级限流阈值（4 级：用户/租户/模型/供应商）
#RATE_LIMIT_TENANT=100
#RATE_LIMIT_MODEL=50
#RATE_LIMIT_SUPPLIER=200
# LLM 调用多级限流（更严格）
#RATE_LIMIT_LLM_USER=10
#RATE_LIMIT_LLM_TENANT=50
#RATE_LIMIT_LLM_MODEL=20
#RATE_LIMIT_LLM_SUPPLIER=100

# ── 用户缓存配置（P0-3 优化）──
# USER_CACHE_TTL_SECONDS: 用户对象缓存 TTL（秒），默认 60
# 缓存命中时 get_current_user 跳过 DB 查询；TTL 60s 平衡实时性与性能
# 用户被禁用/删除后最多 TTL 时间内失效（管理后台修改用户会主动失效缓存）
#USER_CACHE_TTL_SECONDS=60

# ── 数据库连接池配置（生产环境）──
# PostgreSQL 连接池已优化为 pool_size=20 + max_overflow=20（共 40 连接）
# 如需调整，修改 backend/app/database/core.py 中 create_engine 的参数
# SQLite 使用 QueuePool + WAL 模式，pool_size=10 + max_overflow=10

# Service URLs (for Docker networking)
# KOL_SEARCH_URL=http://kol-search:8101
# REPORT_SERVER_URL=http://report-server:8104
