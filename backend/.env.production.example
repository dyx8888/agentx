# ============================================================================
# AgentX Backend - 生产环境变量模板
# ============================================================================
# 使用方法：
#   1. 复制本文件为 .env.production：cp .env.production.example .env.production
#   2. 将所有 <占位符> 替换为真实值（切勿填入代码仓库）
#   3. 启动时通过 --env-file .env.production 加载，或导出到容器环境变量
#   4. 敏感字段（密钥、密码、Token）禁止使用示例值，必须重新生成
#
# 安全提示：
#   - 本文件仅作模板，禁止填入真实密钥后提交到代码仓库
#   - ENV=prod 时启动会强制校验 JWT_SECRET_KEY / ENCRYPTION_KEY，缺失或为默认值会 RuntimeError
#   - CORS_ORIGINS 在生产环境禁止配置为 "*"，否则启动会 RuntimeError
# ============================================================================

# ── 运行环境与基础配置 ──────────────────────────────────────────
# ENV: 运行环境标识。prod 表示生产环境（触发密钥强校验、JSON 日志、CORS 严格校验）
ENV=prod

# ENVIRONMENT: 加密模块回退密钥开关。生产环境必须留空或设置为非 development 值；
#              值为 development 时会启用不安全的固定回退密钥（仅限本地调试）
# ENVIRONMENT=production

# SERVICE_NAME: 日志中的服务标识，用于多服务架构中区分日志来源
SERVICE_NAME=agentx-backend

# PORT: API 服务监听端口（容器内端口，生产环境建议通过反向代理暴露 80/443）
PORT=8000

# FRONTEND_URL: 前端站点根地址，用于邮件链接、OAuth 回跳等场景拼接完整 URL
FRONTEND_URL=https://your-frontend.com

# ── CORS 跨域配置（生产环境强制要求）────────────────────────────
# CORS_ORIGINS: 允许跨域访问的前端域名，多个用英文逗号分隔
# 生产环境禁止使用 "*"，否则启动会 RuntimeError（CSRF 风险）
# 示例：CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=https://your-frontend.com

# ── 安全密钥（生产环境必填，缺失会 RuntimeError 阻止启动）──────────
# JWT_SECRET_KEY: JWT 签名密钥，用于签发/校验 access_token 和 refresh_token
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
# 禁止使用 changeme / default / your_jwt_secret 等默认值
JWT_SECRET_KEY=<请用 secrets.token_hex(32) 生成 64 位十六进制字符串>

# ENCRYPTION_KEY: 数据库敏感字段加密密钥（API Key、平台凭证等），必须是合法 Fernet key
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=<请用 Fernet.generate_key() 生成>

# ── JWT 过期与轮换策略 ─────────────────────────────────────────
# JWT_EXPIRE_MINUTES: access token 有效期（分钟），默认 30
JWT_EXPIRE_MINUTES=30

# JWT_REFRESH_EXPIRE_DAYS: refresh token 有效期（天），默认 7
JWT_REFRESH_EXPIRE_DAYS=7

# REFRESH_TOKEN_ROTATION: 是否启用 refresh token 轮换（true/false），启用后每次刷新会签发新 refresh token
REFRESH_TOKEN_ROTATION=true

# COOKIE_SECURE: HTTPS 生产环境必须为 true；本地 Docker HTTP 演练可临时设为 false
COOKIE_SECURE=true

# ALLOW_PLATFORM_MOCK_FALLBACK: whether official/platform API failures may return mock data.
# Keep this false in production. If a platform API has no credential or fails, the
# system should report "missing/unavailable data source" instead of fake GMV/KOL/order data.
ALLOW_PLATFORM_MOCK_FALLBACK=false

# ALLOW_ENTERPRISE_MOCK_INTEGRATIONS: whether ERP/WMS/customer-service mock integrations may return data.
# Keep this false in production. Real enterprise integrations should fail closed until configured.
ALLOW_ENTERPRISE_MOCK_INTEGRATIONS=false

# ALLOW_CUSTOMER_SERVICE_AUTO_SEND: whether low-risk/high-confidence customer-service
# replies may be sent without human review. Keep false until outbound messaging has
# completed platform-specific acceptance testing.
ALLOW_CUSTOMER_SERVICE_AUTO_SEND=false

# ENABLE_EVOLUTION_API: expose self-evolution/admin evolution routes. Keep false in production.
ENABLE_EVOLUTION_API=false

# ── 数据库配置 ─────────────────────────────────────────────────
# DATABASE_URL: 数据库连接串。生产环境推荐 PostgreSQL；
#              留空时回退到本地 SQLite（仅开发用，生产环境不建议）
# 示例：postgresql://agentx:strongpassword@db-host:5432/agentx
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# TEST_MODE: 测试模式开关（true/false）。生产环境必须为 false 或留空
# TEST_MODE=false

# ── Redis 配置（生产环境强烈建议配置）──────────────────────────
# REDIS_URL: Redis 连接串。多实例部署时共享限流计数、用户缓存、session、token 黑名单
# 未配置时部分功能会降级到内存模式（仅单实例可用）
REDIS_URL=redis://host:6379/0

# RATE_LIMIT_REDIS_URL: 限流专用 Redis（留空则复用 REDIS_URL）
# RATE_LIMIT_REDIS_URL=redis://host:6379/1

# ── 向量数据库（Milvus）配置 ───────────────────────────────────
# VECTOR_DB: 向量后端类型，生产默认 milvus（可选 chromadb，但不推荐生产使用）
VECTOR_DB=milvus

# MILVUS_HOST / MILVUS_PORT: Milvus 服务地址与端口
MILVUS_HOST=milvus
MILVUS_PORT=19530

# MILVUS_COLLECTION: 文本向量 Collection 名（默认 company_knowledge）
MILVUS_COLLECTION=agentx_vectors

# MILVUS_IMAGE_COLLECTION: 图像向量 Collection 名（多模态检索用，与文本分离）
MILVUS_IMAGE_COLLECTION=company_images

# ── LLM 模型 API Key ──────────────────────────────────────────
# DEEPSEEK_API_KEY: DeepSeek 模型 API Key（主模型 deepseek-chat 使用）
# 获取地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=<your-deepseek-api-key>
# TOKENRHYTHM_API_KEY=<your-tokenrhythm-api-key>
# AGENT_EVAL_BASE_URL=https://your-relay.example.com/v1
# AGENT_EVAL_API_KEY=<your-relay-api-key>
# AGENT_EVAL_MODEL_NAME=default
# MODEL_GATEWAY_DEFAULT=deepseek
# AGENT_EVAL_MODEL=deepseek
# EVALUATION_MODEL=deepseek

# OPENAI_API_KEY: OpenAI 模型 API Key（gpt-4o 等模型使用，未用可留空）
# OPENAI_API_KEY=<your-openai-api-key>

# ── 嵌入服务配置 ───────────────────────────────────────────────
# EMBEDDING_MODE: 嵌入后端模式
#   local              - 本地 sentence-transformers 模型（默认，无需 API Key）
#   api_siliconflow    - 硅基流动 API
#   api_deepseek       - DeepSeek API
#   api_openai         - OpenAI API
EMBEDDING_MODE=local

# EMBEDDING_API_KEY: 嵌入 API 全局兜底密钥（local 模式可留空；API 模式必填）
# 各公司可在管理后台配置独立 embedding_config 覆盖此值
EMBEDDING_API_KEY=

# EMBEDDING_MODEL: 本地模式加载的模型名（默认 BAAI/bge-small-zh-v1.5）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# CLIP_MODEL: 多模态图像检索使用的 CLIP 模型（默认 openai/clip-vit-base-patch32）
CLIP_MODEL=openai/clip-vit-base-patch32

# RAG_FRAMEWORK: RAG 检索框架选择
#   hybrid     - 自研 HybridRetriever（BM25 + 向量 + RRF + Reranker，默认）
#   llamaindex - LlamaIndex 标准框架（VectorStoreIndex + MilvusVectorStore）
RAG_FRAMEWORK=hybrid

# GRAPH_RAG_DYNAMIC_EXTRACTION_MODE:
#   async - 推荐生产默认值，知识上传先返回，后台抽取图谱实体
#   sync  - 严格同步抽取，上传会等待外部 LLM，速度较慢
#   off   - 关闭动态图谱抽取，仅保留基础图谱与普通 RAG 检索
GRAPH_RAG_DYNAMIC_EXTRACTION_MODE=async

# ── SMTP 邮件通知配置 ─────────────────────────────────────────
# 未配置 SMTP_HOST 时邮件通知功能自动跳过，不会阻塞主流程
# 用于 evolution notifier（进化通知）、密码重置等场景
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notify@example.com
SMTP_PASSWORD=<your-smtp-password>
SMTP_FROM=notify@example.com

# SMTP_USE_TLS: 是否启用 TLS 加密（true/false），生产环境建议 true
SMTP_USE_TLS=true

# ADMIN_EMAIL: 管理员邮箱，接收系统级告警通知
ADMIN_EMAIL=admin@example.com

# ── OAuth 授权回调配置 ─────────────────────────────────────────
# OAUTH_REDIRECT_BASE_URL: 后端 OAuth 回调基础地址（用于拼接 /api/oauth/callback）
OAUTH_REDIRECT_BASE_URL=https://api.your-domain.com

# OAUTH_FRONTEND_REDIRECT_URL: OAuth 授权完成后前端跳转地址
OAUTH_FRONTEND_REDIRECT_URL=https://your-frontend.com/oauth/callback

# ── 平台集成（达人/电商数据源）────────────────────────────────
# 抖音星图 API 凭证（未接入可留空）
DOUYIN_STAR_API_BASE_URL=https://api.douyinstar.com
DOUYIN_STAR_API_KEY=<your-douyin-star-api-key>
DOUYIN_STAR_API_SECRET=<your-douyin-star-api-secret>

# ── 日志配置 ───────────────────────────────────────────────────
# LOG_LEVEL: 日志级别（DEBUG/INFO/WARNING/ERROR/CRITICAL），生产环境建议 INFO
LOG_LEVEL=INFO

# LOG_TO_FILE: 是否启用文件日志（true/false）。生产环境建议 true，配合日志轮转防磁盘打满
LOG_TO_FILE=true

# LOG_DIR: 日志目录（相对于 backend 根目录）
LOG_DIR=./logs

# LOG_FILE: 主日志文件名
LOG_FILE=app.log

# LOG_MAX_BYTES: 单个日志文件最大字节数，超过后轮转（默认 10MB = 10485760）
LOG_MAX_BYTES=10485760

# LOG_BACKUP_COUNT: 轮转保留的备份文件数量（默认 7）
LOG_BACKUP_COUNT=7

# ── 工具与技能加载配置 ─────────────────────────────────────────
# TOOL_LOAD_MODE: 工具加载模式
#   local - 进程内加载（默认，单体部署）
#   http  - HTTP 工具服务模式（Docker 多容器部署，工具服务独立运行）
# TOOL_LOAD_MODE=local

# TOOL_PROVIDERS_CONFIG: 工具提供方配置文件路径
# TOOL_PROVIDERS_CONFIG=config/tool_providers.yaml

# SKILLS_CONFIG: 技能配置文件路径
# SKILLS_CONFIG=config/skills.yaml

# RUN_AS_HTTP_SERVICE: 是否以独立 HTTP 服务模式运行工具服务器（true/false）
# RUN_AS_HTTP_SERVICE=false

# ── 会话与记忆配置 ─────────────────────────────────────────────
# SESSION_TTL_SECONDS: 会话过期时间（秒）
# SESSION_TTL_SECONDS=86400

# SESSION_MAX_MESSAGES: 单会话最大消息数（超过后触发摘要压缩）
# SESSION_MAX_MESSAGES=20

# SESSION_MAX_TOKENS: 单会话最大 token 数
# SESSION_MAX_TOKENS=8000

# SESSION_SUMMARY_TTL_SECONDS: 会话摘要保留时间（秒）
# SESSION_SUMMARY_TTL_SECONDS=604800

# MAX_SEMANTIC_MEMORIES: 单个 agent 最大语义记忆条数
# MAX_SEMANTIC_MEMORIES=100

# SHORT_TERM_CONSOLIDATION_THRESHOLD: 短期记忆整合阈值
# SHORT_TERM_CONSOLIDATION_THRESHOLD=10

# SLEEP_CONSOLIDATION_INTERVAL_SEC: 睡眠记忆整合任务执行间隔（秒）
# SLEEP_CONSOLIDATION_INTERVAL_SEC=3600

# ── 用户缓存配置 ───────────────────────────────────────────────
# USER_CACHE_TTL_SECONDS: 用户对象缓存 TTL（秒），缓存命中时跳过 DB 查询
USER_CACHE_TTL_SECONDS=60

# ── Hugging Face 镜像（国内加速模型下载）──────────────────────
HF_ENDPOINT=https://hf-mirror.com
