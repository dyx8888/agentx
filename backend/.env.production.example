# AgentX production environment template
# Copy this to your deployment platform's secret/environment variable store.
# Do not commit a filled production .env file.

# Required
ENVIRONMENT=production
ENV=prod
# Set this in the deployment platform to a managed Postgres URL.
DATABASE_URL=
JWT_SECRET_KEY=
FRONTEND_URL=https://your-frontend.example.com
CORS_ORIGINS=https://your-frontend.example.com
COOKIE_SECURE=true
ENABLE_PUBLIC_DOCS=false
ENABLE_EVOLUTION_API=false

# Optional infrastructure
# REDIS_URL=redis://USER:PASSWORD@HOST:6379/0
# MILVUS_HOST=
# MILVUS_PORT=19530

# Optional email reset flow
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# Optional OAuth / platform integrations
# OAUTH_REDIRECT_BASE_URL=https://your-backend.example.com
# TAOBAO_APP_KEY=
# TAOBAO_APP_SECRET=
# DOUYIN_SHOP_APP_KEY=
# DOUYIN_SHOP_APP_SECRET=
# PINDUODUO_CLIENT_ID=
# PINDUODUO_CLIENT_SECRET=
# XIAOHONGSHU_APP_ID=
# XIAOHONGSHU_APP_SECRET=

# Optional model providers
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
