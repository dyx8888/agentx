{
  "manifest_version": 3,
  "name": "AgentX Browser Connector MVP",
  "description": "Read-only connector that captures user-selected page data and approved API responses, then forwards sanitized data to AgentX.",
  "version": "0.2.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "AgentX Connector"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*/*"
      ],
      "js": ["src/platform-policy.js", "src/content-script.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ],
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "web_accessible_resources": [
    {
      "resources": ["src/injected.js"],
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*/*"
      ]
    }
  ]
}
